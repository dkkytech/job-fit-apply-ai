#!/usr/bin/with-contenv bash
# The viewer is a browser signed in to Richard's Google account: never serve it without a password.
# linuxserver ignores a failing custom init, so halt the whole container explicitly.
if [ -z "${PASSWORD:-}" ]; then
  echo "[jobbot-browser] refusing to start: JOBBOT_BROWSER_PASSWORD (PASSWORD) is blank" >&2
  /run/s6/basedir/bin/halt
  exit 1
fi
