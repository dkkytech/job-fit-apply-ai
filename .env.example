# Root docker-compose config — copy to .env and adjust.
# The compose file has defaults for all of these, so .env is optional for local use.

# ── Instance identity (multi-instance support — see docs/multi-instance.md) ──
# Pin the compose project name so a second instance can never collide with (or orphan)
# this one's containers, network, and named volumes. ⚠ On an EXISTING deployment this
# must match the currently effective project name EXACTLY (check `docker compose ls` /
# `docker volume ls`) — a wrong value boots the stack with a fresh empty DB volume.
COMPOSE_PROJECT_NAME=job-fit-apply-ai
# Prefix for every container_name. Prod keeps the default; a test instance uses its own.
#CONTAINER_PREFIX=jobfit
# The Gmail-touching intake services (poller, jsearch) are profile-gated so a test
# instance can exclude them. REQUIRED in prod's .env: without it a bare
# `docker compose up` silently drops poller + jsearch.
COMPOSE_PROFILES=intake
# Host port the steel service publishes (container side stays 3000).
#STEEL_PORT=3000
# Pipeline dotenv the processor mounts at /app/.env. A second instance points this at
# its own copy (ARTIFACT_BASE_URL differs per instance and cannot come from compose
# `environment:` — the blank-override hazard documented in docker-compose.yml).
#PIPELINE_ENV_FILE=./services/job-fit-apply-ai-pipeline/.env

# Postgres container (db service)
POSTGRES_USER=jobfit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jobfit
POSTGRES_PORT=5432

# Connection string for the app services (pipeline JDBC / bridge API), wired up
# in later migration steps.
#   • host apps (run on the Mac):        host = localhost
#   • app containers (same compose net): host = db
DATABASE_URL=postgresql://jobfit:change-me@localhost:5432/jobfit

# markserv container (serves the pipeline output dir; reached via Tailscale on this port)
MARKSERV_PORT=8081

# Durable JFAA bind-mount data. Set this once per host; Compose derives bridge/, jsearch-state/,
# notifier-state/, poller-secrets/, pipeline-output/, and pipeline-state/ below it. Examples:
#   macOS:          /Users/<user>/Library/Application Support/JFAA
#   Ubuntu service: /var/lib/jfaa
#   Ubuntu dev:     /home/<user>/.local/share/jfaa
# The Compose fallback when this is unset is ${HOME}/.local/share/jfaa. GitHub Actions E2E overrides
# these mounts with repo-local ./.e2e state and does not need this variable. Existing deployments
# using ~/.openclaw/jd-* or repo-local Pipeline output/state MUST migrate their data before recreating
# affected services; see docs/data-root-migration.md.
#JFAA_DATA_ROOT=
# Advanced compatibility overrides; set one only when a service must use a different location.
#JD_BRIDGE_STORE_HOST=
#JD_JSEARCH_STATE_HOST=
#JD_NOTIFIER_STATE_HOST=
#JD_POLLER_SECRETS_HOST=
#JD_PIPELINE_OUTPUT_HOST=
#JD_PIPELINE_STATE_HOST=

# Frontend build: the bridge URL the browser calls (baked into the bundle at build time).
# Use your host's Tailscale name so the served app reaches the bridge over the tailnet.
VITE_API_BASE_URL=http://richards-macbook-m1-max.tail02d0e.ts.net:8765

# Processor container (jobfit-processor)
# Public URL base for artifact links in reports/notifications — markserv over the tailnet.
# Blank = no artifact URLs in metadata.
#ARTIFACT_BASE_URL=http://richards-macbook-m1-max.tail02d0e.ts.net:8081
# Remote-debugging port of the host CDP Chrome the processor scrapes through (launch-chrome-cdp.sh).
#CHROME_DEBUG_PORT=9222

# Notifications. Namespaced Telegram credentials separate high-fit job alerts from
# run-analyzer findings. Leave a namespaced value blank to fall back to TELEGRAM_*.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
NOTIFIER_TELEGRAM_BOT_TOKEN=
NOTIFIER_TELEGRAM_CHAT_ID=
# The launchd run analyzer reads services/job-fit-apply-ai-pipeline/.env instead.
# Configure RUN_ANALYZER_TELEGRAM_* there; see tuner/run-analyzer/README.md.
# Backward-compatible Telegram fallback shared by older deployments.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Steel Browser backend (self-hosted `steel` service). Set STEEL_BASE_URL to route scraping through
# Steel (sessions + persisted auth + phone re-auth); blank/unset falls back to the host-Chrome CDP
# path above. This is the on/off + cutover switch.
#STEEL_BASE_URL=http://steel:3000
# Tailnet base for the interactive debug link in re-auth alerts (open on a phone to sign in).
#STEEL_UI_URL=http://richards-macbook-m1-max.tail02d0e.ts.net:3000
# Host interface the `steel` service publishes port 3000 on — set to the host's Tailscale IP so the
# debug URL is reachable from a phone. Defaults to 127.0.0.1 (loopback only; the Steel UI has no auth).
#STEEL_BIND_ADDR=100.x.y.z

# Tap-to-sign-in endpoint (hosted in the Processor). A re-auth alert links here instead of at a live
# scrape session: that session is released when the batch ends, so its debug link is almost always
# dead by the time you read the alert and tap. This endpoint creates the session when you tap it,
# parks it on the site's login page, and captures cookies automatically while you sign in.
# Setting the public URL is the on/off switch — blank means the endpoint isn't started or advertised.
#STEEL_SIGNIN_PUBLIC_URL=http://richards-macbook-m1-max.tail02d0e.ts.net:3100
# Host interface the processor publishes the endpoint on. Same rule as STEEL_BIND_ADDR: set it to the
# host's Tailscale IP to reach it from a phone, never 0.0.0.0 — the live view it hands out has no auth.
#STEEL_SIGNIN_BIND_ADDR=100.x.y.z
#STEEL_SIGNIN_PORT=3100
# Shared secret required as ?token= on every request (and included in the alert link). Recommended:
# unlike the Steel UI, this endpoint *creates* browser sessions, so one stray request costs you a
# 30-minute window during which scraping stands down.
#STEEL_SIGNIN_TOKEN=
# How long a sign-in session stays open. A ceiling, not a target — the session closes as soon as the
# sign-in lands. Raise it if you tend to start a sign-in and get pulled away. Default 30 min.
#STEEL_SIGNIN_WINDOW_MS=1800000
