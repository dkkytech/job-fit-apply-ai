<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd agent: keep the self-hosted Steel Browser backend able to scrape (watchdog).

  Runs steel-watchdog.sh at login (RunAtLoad) and every 120s (StartInterval). The script is
  short-lived: it does one real `POST /v1/sessions` probe — the only thing that detects a wedged
  Steel (API healthy, but browser reuse broken → HTTP 500 on createSession) — and, on two
  consecutive failures, `docker restart`s jobfit-steel. Docker's own `restart: unless-stopped`
  can't do this: an unhealthy-but-running container isn't a process exit, so it never fires.

  Interval note: 120s (not 60s like chrome-cdp) because each probe creates+releases a real browser
  session; a wedge persists until restart, so a couple minutes' detection latency is fine and keeps
  the probe load on Steel's single browser gentle.

  Install (edit the ProgramArguments path below if your checkout differs):
    cp scripts/com.jd.steel-watchdog.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.jd.steel-watchdog.plist

  Status / logs:
    launchctl print gui/$(id -u)/com.jd.steel-watchdog | grep -i state
    tail -f /tmp/jd-steel-watchdog.out.log /tmp/jd-steel-watchdog.err.log

  Uninstall:
    launchctl bootout gui/$(id -u)/com.jd.steel-watchdog
    rm ~/Library/LaunchAgents/com.jd.steel-watchdog.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jd.steel-watchdog</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/dkkyai/projects/job-fit-apply-ai/services/job-fit-apply-ai-pipeline/scripts/steel-watchdog.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>StartInterval</key>
    <integer>120</integer>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>/tmp/jd-steel-watchdog.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/jd-steel-watchdog.err.log</string>
</dict>
</plist>
