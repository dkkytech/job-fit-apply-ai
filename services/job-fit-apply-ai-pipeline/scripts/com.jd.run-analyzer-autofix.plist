<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd agent: run-analyzer AUTO-FIX pass (gated; daily).

  Runs `run_analyzer.sh --autofix` once a day (StartCalendarInterval 09:15). This pass is
  DEFAULT OFF — it no-ops unless RUN_ANALYZER_AUTOFIX=1 (see EnvironmentVariables below).
  When armed it maintains ONE living draft PR: it applies fixes for new high-severity findings
  on an isolated worktree branch, gates each with `./gradlew test`, opens/updates a DRAFT PR
  (never merges), and notifies you with the PR URL. Findings already covered by the open PR
  (matched by commit-trailer fingerprint) are skipped, so it won't churn.

  The shared /tmp/jd-run-analyzer.lock guarantees it never overlaps the hourly analysis job.
  Needs an authed `gh` and the `claude` CLI on PATH.

  To ARM it, uncomment the EnvironmentVariables block below (or export RUN_ANALYZER_AUTOFIX=1
  in the launchd user environment). Leave it commented to keep the loop off but scheduled.

  Install (edit ProgramArguments path if your checkout differs):
    cp scripts/com.jd.run-analyzer-autofix.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.jd.run-analyzer-autofix.plist

  Status / logs:
    launchctl print gui/$(id -u)/com.jd.run-analyzer-autofix | grep -i state
    tail -f /tmp/jd-run-analyzer-autofix.out.log /tmp/jd-run-analyzer-autofix.err.log

  Uninstall:
    launchctl bootout gui/$(id -u)/com.jd.run-analyzer-autofix
    rm ~/Library/LaunchAgents/com.jd.run-analyzer-autofix.plist

  First-run dry check: RUN_ANALYZER_AUTOFIX=1 RUN_ANALYZER_AUTOFIX_DRYRUN=1 \
    tuner/run-analyzer/run_analyzer.sh --autofix   (applies + gates, stops before push/PR/notify)
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jd.run-analyzer-autofix</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/dkkyai/projects/job-fit-apply-ai/services/job-fit-apply-ai-pipeline/tuner/run-analyzer/run_analyzer.sh</string>
        <string>--autofix</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>RUN_ANALYZER_AUTOFIX</key>
        <string>1</string>
        <key>RUN_ANALYZER_AUTOFIX_SEVERITY</key>
        <string>medium</string>
        <key>RUN_ANALYZER_AUTOFIX_GATE</key>
        <string>cd services/job-fit-apply-ai-pipeline &amp;&amp; ./gradlew test</string>
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>15</integer>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>/tmp/jd-run-analyzer-autofix.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/jd-run-analyzer-autofix.err.log</string>
</dict>
</plist>
