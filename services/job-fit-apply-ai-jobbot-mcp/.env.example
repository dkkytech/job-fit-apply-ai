# jobbot-mcp — local runs only; compose passes every value explicitly.
JD_BRIDGE_URL=http://127.0.0.1:8765
JOBBOT_MCP_PORT=8790
# Shared with the jobbot (Hermes) container. Generate with: openssl rand -hex 32
JOBBOT_MCP_TOKEN=
JOBBOT_TELEGRAM_ALLOWED_USERS=
# Verbs JobBot acts on (apply,archive,reply). Unlisted verbs are refused.
JOBBOT_ACTIONS=apply
JOBBOT_DRY_RUN=false
JOBBOT_STATE_DIR=./state
JOBBOT_OUTPUT_ROOT=
JOBBOT_RESUME_YAML=
JOBBOT_CANDIDATE_PROFILE_YAML=
