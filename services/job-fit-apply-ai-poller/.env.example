# Poller configuration (the only Gmail-touching service — Phase 1).
# Copy to .env and adjust paths. The Poller reuses the existing Gmail token/credentials.

# Bridge feed + submit endpoint
JD_BRIDGE_URL=http://127.0.0.1:8765

# Gmail OAuth. Point these at the existing credentials/token so no re-auth is needed at cutover.
# Absolute paths are recommended (the Poller runs from its own working directory).
GMAIL_CREDENTIALS_FILE=/abs/path/to/services/job-fit-apply-ai-pipeline/dkkytech_credentials.json
GMAIL_TOKEN_FILE=/abs/path/to/services/job-fit-apply-ai-pipeline/tokens/gmail_token.json

# Emails submitted per poll (kept small for a single Cloud LLM worker), and the most messages
# fetched per poll while paging past skipped replies / blank-body emails to fill that batch
INTAKE_BATCH_SIZE=3
INTAKE_MAX_SCAN=100

# Poll cadence (ms)
INTAKE_POLL_INTERVAL_MS=60000
# Wait between submissions so a single Cloud LLM worker can drain each job.
INTAKE_INTER_SUBMIT_DELAY_MS=15000
WRITEBACK_POLL_INTERVAL_MS=15000
