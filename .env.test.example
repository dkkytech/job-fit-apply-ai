# Second-instance ("test") config — copy to .env.test (gitignored) and adjust.
#
#   cp .env.test.example .env.test
#   cp services/job-fit-apply-ai-pipeline/.env services/job-fit-apply-ai-pipeline/.env.test
#   make up INSTANCE=test
#
# ⚠ `docker compose --env-file .env.test` REPLACES the default .env entirely — nothing is
# inherited. Every value the test instance needs must be restated here, even ones whose
# prod value would have been fine. See docs/multi-instance.md for the full runbook.

# ── Instance identity ────────────────────────────────────────────────────────
# Distinct project name + container prefix keep containers, the network, and the named
# volumes (db data, steel cache) fully separate from prod.
COMPOSE_PROJECT_NAME=jobfit-test
CONTAINER_PREFIX=jobfit-test
# Empty on purpose: the test instance runs NO poller/jsearch. Gmail labels are
# account-global — a second poller would race prod and double-process. Jobs enter the
# test instance via scripts/replay-jobs.sh (make replay) instead.
COMPOSE_PROFILES=

# ── Host ports (prod + 20000) ────────────────────────────────────────────────
# Chosen to avoid prod (5432/8765/3030/8081/3000/3100), the E2E slice
# (15433/18765/18082/18099/21436), and Roomote A/B/C (13000–15002, 15432, 18081).
POSTGRES_PORT=25432
JD_BRIDGE_PORT=28765
FRONTEND_PORT=23030
MARKSERV_PORT=28081
STEEL_PORT=23000
STEEL_SIGNIN_PORT=23100

# ── Durable state — ONE line isolates everything ─────────────────────────────
# All six durable mounts (bridge, jsearch-state, notifier-state, poller-secrets,
# pipeline-output, pipeline-state) derive from this root. A distinct path here is the
# whole per-instance state story; full reset =
#   make down INSTANCE=test && docker compose --env-file .env.test down -v && rm -rf <this dir>
JFAA_DATA_ROOT=/Users/CHANGE-ME/Library/Application Support/JFAA-test

# ── Postgres (own container + volume, so credentials are free to differ) ─────
POSTGRES_USER=jobfit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jobfit

# ── Pipeline dotenv (per-instance copy — the A/B lever) ──────────────────────
# Must point at a gitignored COPY of the prod pipeline .env, edited so that:
#   ARTIFACT_BASE_URL=http://<tailscale-name>:28081   (this instance's markserv)
#   LOCAL_LLM_MAX_CONCURRENCY=1                       (soften shared-LLM contention)
# Model/config changes under test also go in that file only.
PIPELINE_ENV_FILE=./services/job-fit-apply-ai-pipeline/.env.test

# ── Frontend (bundle bakes the bridge URL at build time) ─────────────────────
VITE_API_BASE_URL=http://CHANGE-ME.ts.net:28765

# ── Steel Browser ────────────────────────────────────────────────────────────
# In-network URL — per-project network, so the same value as prod is correct.
STEEL_BASE_URL=http://steel:3000
STEEL_UI_URL=http://CHANGE-ME.ts.net:23000
#STEEL_BIND_ADDR=100.x.y.z

# ── Notifications — TEST channels only, never prod's ─────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
NOTIFIER_TELEGRAM_BOT_TOKEN=
NOTIFIER_TELEGRAM_CHAT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFICATION_FIT_THRESHOLD=50
